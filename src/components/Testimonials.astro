---
import testimonialsData from "../data/testimonials.json";

interface Testimonial {
  name: string;
  role?: string;
  company?: string;
  avatar?: string;
  rating?: number;
  quote: string;
}

const testimonials = testimonialsData as Testimonial[];

const getInitials = (name: string) =>
  name
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part.charAt(0).toUpperCase())
    .join("");

const clampRating = (rating?: number) =>
  Math.max(1, Math.min(5, Math.round(rating ?? 5)));
---

{
  testimonials.length > 0 && (
    <section id="testimonials" class="testimonials-section py-20">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12">
          <span class="testimonials-chip">
            <i class="fa-solid fa-heart" aria-hidden="true" />
            Kind words
          </span>
          <h2 class="section-title text-center mt-4">Testimonials</h2>
          <p class="testimonials-subtitle">
            A few lovely things clients and teammates have said about working
            with me.
          </p>
        </div>

        <div class="testimonials-grid">
          {testimonials.map((testimonial) => (
            <figure class="testimonial-card">
              <span class="testimonial-quote-mark" aria-hidden="true">
                &ldquo;
              </span>

              <div
                class="testimonial-stars"
                aria-label={`${clampRating(testimonial.rating)} out of 5 stars`}
              >
                {Array.from({ length: clampRating(testimonial.rating) }).map(
                  () => (
                    <i class="fa-solid fa-star" aria-hidden="true" />
                  ),
                )}
              </div>

              <blockquote class="testimonial-quote">
                {testimonial.quote}
              </blockquote>

              <figcaption class="testimonial-author">
                {testimonial.avatar ? (
                  <img
                    class="testimonial-avatar"
                    src={testimonial.avatar}
                    alt={testimonial.name}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="testimonial-avatar testimonial-avatar-initials">
                    {getInitials(testimonial.name)}
                  </span>
                )}
                <span class="testimonial-author-meta">
                  <span class="testimonial-name">{testimonial.name}</span>
                  {(testimonial.role || testimonial.company) && (
                    <span class="testimonial-role">
                      {[testimonial.role, testimonial.company]
                        .filter(Boolean)
                        .join(" · ")}
                    </span>
                  )}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
